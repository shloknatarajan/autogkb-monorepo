# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Environments
.env
.envrc
.venv/
.pixi/
.ruff_cache/

# OS
.DS_Store
__MACOSX/

# Node
node_modules/
packages/app/dist/

# Data backups
data/backups/

# Archives
*.zip

# Generated LitSuggest evaluation outputs
data/litsuggest/*.jsonl
data/litsuggest/abstracts_cache.jsonl
litsuggest-triage-accuracy.html

# Office lock files
~$*.xlsx

# IDE
.idea/
.vscode/
*.swp

# Images (from benchmark)
*.png

# Docs
docs/superpowers/

# Git worktrees
.worktrees/

# claude
.claude
.cursor
**/docs/superpowers/

# Root hygiene: keep project files in their owning directories. Add new root-level
# configuration files to this allowlist intentionally.
/*
!/.env.example
!/.gitignore
!/.python-version
!/README.md
!/pyproject.toml
!/railway.json
!/uv.lock
!/.github/
!/data/
!/docs/
!/packages/
